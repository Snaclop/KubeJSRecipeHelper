          },
          "kind": "item",
          "output": false,
          "min": 0,
          "max": 64,
          "initial": 1,
          "maxCount": 64,
          "totalByCount": true,
          "maxTotal": 64
        },
        {
          "id": "outputs",
          "label": {
            "zh-CN": "产物",
            "zh-TW": "產物",
            "en": "Output"
          },
          "kind": "item",
          "output": true,
          "min": 0,
          "max": 4,
          "initial": 1,
          "chance": true,
          "positiveChanceVersions": [
            "1.21.1"
          ]
        },
        {
          "id": "fluid_inputs",
          "label": {
            "zh-CN": "流体原料",
            "zh-TW": "流體原料",
            "en": "Fluid inputs"
          },
          "kind": "fluid",
          "output": false,
          "min": 0,
          "max": 2,
          "initial": 1
        },
        {
          "id": "fluid_outputs",
          "label": "流体产物",
          "kind": "fluid",
          "output": true,
          "min": 0,
          "max": 2,
          "initial": 1
        }
      ],
      "fields": [
        {
          "id": "custom_time",
          "label": {
            "zh-CN": "指定处理时间",
            "zh-TW": "指定處理時間",
            "en": "Set processing time"
          },
          "type": "boolean",
          "default": false
        },
        {
          "id": "time",
          "label": {
            "zh-CN": "处理时间 (tick)",
            "zh-TW": "處理時間 (tick)",
            "en": "Time (tick)"
          },
          "type": "integer",
          "default": 100,
          "min": 1,
          "max": 99999999,
          "when": {
            "field": "custom_time",
            "equals": true
          }
        },
        {
          "id": "heat",
          "label": {
            "zh-CN": "热量条件",
            "zh-TW": "熱量條件",
            "en": "Heat"
          },
          "type": "choice",
          "default": "",
          "choices": [
            {
              "label": {
                "zh-CN": "无需加热",
                "zh-TW": "無需加熱",
                "en": "None"
              },
              "value": ""
            },
            {
              "label": {
                "zh-CN": "加热",
                "zh-TW": "加熱",
                "en": "Heated"
              },
              "value": "heated"
            },
            {
              "label": {
                "zh-CN": "超级加热",
                "zh-TW": "超級加熱",
                "en": "Superheated"
              },
              "value": "superheated"
            }
          ]
        }
      ],
      "requireAny": [
        [
          "inputs",
          "fluid_inputs"
        ],
        [
          "outputs",
          "fluid_outputs"
        ]
      ],
      "output": {
        "$version": {
          "1.20.1": {
            "type": "createdieselgenerators:basin_fermenting",
            "ingredients": {
              "$concat": [
                {
                  "$each": "inputs",
                  "$value": {
                    "item": {
                      "$ref": "entry.id"
                    }
                  },
                  "$repeatCount": true
                },
                {
                  "$each": "fluid_inputs",
                  "$value": {
                    "fluid": {
                      "$ref": "entry.id"
                    },
                    "amount": {
                      "$ref": "entry.count"
                    }
                  }
                }
              ]
            },
            "results": {
              "$concat": [
                {
                  "$each": "outputs",
                  "$value": {
                    "item": {
                      "$ref": "entry.id"
                    },
                    "count": {
                      "$ref": "entry.count"
                    },
                    "chance": {
                      "$ref": "entry.chance",
                      "$scale": 0.01,
                      "$omitIf": 1
                    }
                  }
                },
                {
                  "$each": "fluid_outputs",
                  "$value": {
                    "fluid": {
                      "$ref": "entry.id"
                    },
                    "amount": {
                      "$ref": "entry.count"
                    }
                  }
                }
              ]
            },
            "processingTime": {
              "$when": {
                "field": "custom_time",
                "equals": true
              },
              "$value": {
                "$ref": "params.time"
              }
            },
            "heatRequirement": {
              "$ref": "params.heat",
              "$omitIf": ""
            }
          },
          "1.21.1": {
            "type": "createdieselgenerators:basin_fermenting",
            "ingredients": {
              "$concat": [
                {
                  "$each": "inputs",
                  "$value": {
                    "item": {
                      "$ref": "entry.id"
                    }
                  },
                  "$repeatCount": true
                },
                {
                  "$each": "fluid_inputs",
                  "$value": {
                    "type": "fluid_stack",
                    "fluid": {
                      "$ref": "entry.id"
                    },
                    "amount": {
                      "$ref": "entry.count"
                    }
                  }
                }
              ]
            },
            "results": {
              "$concat": [
                {
                  "$each": "outputs",
                  "$value": {
                    "id": {
                      "$ref": "entry.id"
                    },
                    "count": {
                      "$ref": "entry.count"
                    },
                    "chance": {
                      "$ref": "entry.chance",
                      "$scale": 0.01,
                      "$omitIf": 1
                    }
                  }
                },
                {
                  "$each": "fluid_outputs",
                  "$value": {
                    "id": {
                      "$ref": "entry.id"
                    },
                    "amount": {
                      "$ref": "entry.count"
                    }
                  }
                }
              ]
            },
            "processing_time": {
              "$when": {
                "field": "custom_time",
                "equals": true
              },
              "$value": {
                "$ref": "params.time"
              }
            },
            "heat_requirement": {
              "$ref": "params.heat",
              "$omitIf": ""
            }
          }
        }
      }
    },
