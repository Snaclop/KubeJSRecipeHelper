IDD_KUBEJSRECIPEHELPER_DIALOG DIALOGEX 0, 0, 400, 244
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "KubeJS 配方助手"
FONT 12, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "导入资源",IDC_STATIC,17,6,129,12,SS_CENTERIMAGE
    LTEXT           "添加配方",IDC_STATIC,17,46,129,10,SS_CENTERIMAGE
    LTEXT           "脚本预览",IDC_STATIC,156,6,234,12,SS_CENTERIMAGE
    LTEXT           "先导入 JAR，再选择配方类型。",IDC_STATIC,17,128,129,22,WS_DISABLED
    LTEXT           "生成后可在右侧编辑脚本并导出。",IDC_STATIC,17,152,129,22,WS_DISABLED
    PUSHBUTTON      "导入 .jar 文件",IDC_BTNIMPORT,17,23,129,12
    PUSHBUTTON      "有序合成",IDC_BTNSHAPED,17,62,62,12
    PUSHBUTTON      "无序合成",IDC_BTNSHAPELESS,83,62,62,12
    PUSHBUTTON      "锻造台",IDC_BTNSMITH,17,79,62,12
    PUSHBUTTON      "熔炉、高炉等",IDC_BTNCOOK,83,79,62,12
    PUSHBUTTON      "切石机",IDC_BTNSTONECUT,17,97,62,12
    PUSHBUTTON      "机械动力",IDC_BTNCREATE,83,97,62,12
    PUSHBUTTON      "移除配方（待实现）",IDC_BTNREMOVE,17,180,129,12,WS_DISABLED
    EDITTEXT        IDC_EDITOUTPUT,156,23,234,189,ES_MULTILINE | ES_AUTOHSCROLL | ES_NOHIDESEL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON      "导出到 output.js",IDC_BTNDWNLOAD,286,226,58,12
    PUSHBUTTON      "清除内容",IDC_BTNCLEAR,350,226,40,12
END

IDD_DLGSHAPED DIALOGEX 0, 0, 379, 193
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "有序合成"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,270,174,50,14
    PUSHBUTTON      "取消",IDCANCEL,322,174,50,14
END

IDD_DLGSHAPELESS DIALOGEX 0, 0, 378, 193
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "无序合成"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,268,172,50,14
    PUSHBUTTON      "取消",IDCANCEL,321,172,50,14
END

IDD_DLGSMITH DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "锻造台"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,199,157,50,14
    PUSHBUTTON      "取消",IDCANCEL,253,157,50,14
    GROUPBOX        "输入",IDC_STATICSMITHGROUP,16,51,142,72
    CTEXT           "模板",IDC_STATICSMITHLABEL0,20,105,40,8
    CTEXT           "升级物品",IDC_STATICSMITHLABEL1,67,105,40,8
    CTEXT           "原材料",IDC_STATICSMITHLABEL2,113,105,40,8
    CTEXT           "输出",IDC_STATICSMITHLABEL3,185,105,40,8
    LTEXT           "左键点击格子选择物品，右键清空格子",IDC_STATICSMITHHINT,16,142,170,8
END

IDD_DLGCOOK DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "熔炉等"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,199,157,50,14
    PUSHBUTTON      "取消",IDCANCEL,253,157,50,14
    COMBOBOX        IDC_COMBOCOOK,29,24,48,80,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDITCOOKTIME,111,95,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPINCOOKTIME,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,150,94,10,14
END

IDD_DLGSTONECUT DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "切石机"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
