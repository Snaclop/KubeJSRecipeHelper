    PUSHBUTTON      "取消",IDCANCEL,253,157,50,14
    COMBOBOX        IDC_COMBOCREATE,130,14,48,30,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
END

IDD_DLGSELECT DIALOGEX 0, 0, 291, 314
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择物品"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,179,293,50,14
    PUSHBUTTON      "取消",IDCANCEL,234,293,50,14
    LISTBOX         IDC_LIST,23,31,242,234,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDITSEARCH,23,18,242,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDITNUMBER,31,286,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPINNUMBER,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,70,286,8,14
    GROUPBOX        "数目/体积",IDC_GROUPCOUNT,23,273,68,29
    GROUPBOX        "概率%",IDC_GROUPCHANCE,103,273,68,29
    EDITTEXT        IDC_EDITPOSSIBILITY,111,286,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPINPOSSIBILITY,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,150,286,8,14
END


