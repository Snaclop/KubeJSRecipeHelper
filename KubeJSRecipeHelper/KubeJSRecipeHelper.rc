IDD_KUBEJSRECIPEHELPER_DIALOG DIALOGEX 0, 0, 400, 225
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "KubeJS 配方助手"
FONT 12, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "导入资源",IDC_STATIC,17,6,129,12,SS_CENTERIMAGE
    LTEXT           "添加配方",IDC_STATIC,17,46,129,10,SS_CENTERIMAGE
    LTEXT           "脚本预览",IDC_STATIC,156,6,234,12,SS_CENTERIMAGE
    PUSHBUTTON      "导入 .jar 文件",IDC_BTNIMPORT,17,23,129,12
    PUSHBUTTON      "原版合成",IDC_BTNVANILLA,17,62,129,12
    PUSHBUTTON      "机械动力",IDC_BTNCREATE,17,80,129,12
    PUSHBUTTON      "移除配方",IDC_BTNREMOVE,18,120,127,12
    EDITTEXT        IDC_EDITOUTPUT,156,23,227,189,ES_MULTILINE | ES_AUTOHSCROLL | ES_NOHIDESEL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON      "导出到 output.js",IDC_BTNDWNLOAD,17,177,62,12
    PUSHBUTTON      "清除内容",IDC_BTNCLEAR,83,177,62,12
    PUSHBUTTON      "编辑配方",IDC_BTNMODIFY,18,144,127,12
    PUSHBUTTON      "其它配方",IDC_BTNOTHER,17,97,129,12
END

IDD_DLGCREATE DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "机械动力"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,199,157,50,14
    PUSHBUTTON      "取消",IDCANCEL,253,157,50,14
    COMBOBOX        IDC_COMBOCREATE,130,14,48,30,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
END

IDD_DLGSELECT DIALOGEX 0, 0, 291, 314
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择物品"
FONT 12, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,179,293,50,14
    PUSHBUTTON      "取消",IDCANCEL,234,293,50,14
    LISTBOX         IDC_LIST,23,31,242,234,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDITSEARCH,23,18,242,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDITNUMBER,31,286,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPINNUMBER,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,70,286,8,14
    GROUPBOX        "数目/体积",IDC_GROUPCOUNT,23,273,68,29
    GROUPBOX        "概率%",IDC_GROUPCHANCE,103,273,68,29
    EDITTEXT        IDC_EDITPOSSIBILITY,111,286,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPINPOSSIBILITY,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,150,286,8,14
END

